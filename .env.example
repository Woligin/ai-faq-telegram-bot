# Copy to .env and fill in. Never commit .env.
# Token from @BotFather in Telegram:
TELEGRAM_BOT_TOKEN=

# Optional AI. Leave GEMINI_API_KEY empty to use the built-in keyword answers.
GEMINI_API_KEY=
# Optional: your preferred model first; other Gemini models are tried if it is busy or retired.
LLM_MODEL=

# Optional: your Telegram user id, enables /stats for you only.
ADMIN_ID=
